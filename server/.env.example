# Server configuration
PORT=4000

# REQUIRED in production: long random string (openssl rand -hex 32)
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# CORS (comma-separated). Not needed when the server serves the built client (same origin).
# Example for separate dev frontend: http://localhost:5173
CORS_ORIGINS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

LOG_LEVEL=info

# Database
# Local dev: leave DATABASE_URL empty and sqlite is used (SQLITE_FILE).
# Production: Postgres connection string.
SQLITE_FILE=./data/royalpet.db
# DATABASE_URL=postgresql://user:password@localhost:5432/royalpet
# DATABASE_SSL=false          # only for a local Postgres without SSL

# Staff self-registration codes (server checked). Empty = staff sign-up disabled in production.
DOCTOR_REG_CODE=
RECEPTION_REG_CODE=

# Seed: SEED_DEMO_USERS=true creates the README demo accounts. In production with it unset
# only ONE admin is created from ADMIN_EMAIL / ADMIN_PASSWORD.
SEED_DEMO_USERS=true
# ADMIN_EMAIL=admin@yourclinic.in
# ADMIN_PASSWORD=choose-a-strong-password

# Uploads: local (ephemeral on most hosts) or s3 (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Number of nightly backup copies kept inside the database (default 14)
BACKUP_KEEP_SCHEDULED=14
